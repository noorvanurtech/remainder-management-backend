{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/check-reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/v1/cron/backup",
      "schedule": "10 13 * * *"
    }
  ]
}
